# Qwen accounts (email:password, comma-separated)
# QWEN_ACCOUNTS=user1@example.com:pass1,user2@example.com:pass2
# or direct JWT tokens:
# QWEN_TOKENS=eyJ...,eyJ...

# Optional local API key. Leave empty for local use.
# Production: set this before exposing the service.
# API_KEY=sk-your-key

PORT=3000
TZ=Asia/Shanghai

# Stability defaults
MAX_CONCURRENT_PER_TOKEN=1
MAX_QUEUE_SIZE=100
QUEUE_TIMEOUT_MS=30000
ACCOUNT_MIN_INTERVAL_MS=1200
RATE_LIMIT_BASE_COOLDOWN_MS=600000
RATE_LIMIT_MAX_COOLDOWN_MS=3600000
MAX_TOKEN_ERRORS=3
MODEL_CACHE_TTL_MS=1800000

# WAF 模式：强制使用无头浏览器（Playwright/Chromium）自动采集 cookie。
# 必须使用 Dockerfile.playwright 构建的镜像（轻量镜像不含 Chromium）。
# 采集到的 cookie 会缓存到 data/waf-cookies.json，重启时优先读缓存。
# 仅本地调试想关掉浏览器时设 WAF_AUTO_HARVEST=0（不推荐生产用）。
WAF_AUTO_HARVEST=1
WAF_COOKIE_REFRESH_MS=1200000
WAF_COOKIE_WARMUP_MS=5000
WAF_HARVEST_RETRIES=3
WAF_HARVEST_RETRY_DELAY_MS=5000
# 远程 harvester 服务地址（侧车容器模式，主镜像无需 Chromium）
# 使用 docker-compose.n1.yml 时自动设为 http://waf-harvester:3100，无需手动配置
# WAF_HARVESTER_URL=http://waf-harvester:3100
