# Qwen accounts (email:password, comma-separated)
# QWEN_ACCOUNTS=user1@example.com:pass1,user2@example.com:pass2
# or direct JWT tokens:
# QWEN_TOKENS=eyJ...,eyJ...

# Optional local API key. Leave empty for local use.
# Production: set this before exposing the service.
# API_KEY=sk-your-key

PORT=3000
TZ=Asia/Shanghai

# Stability defaults
MAX_CONCURRENT_PER_TOKEN=1
MAX_QUEUE_SIZE=100
QUEUE_TIMEOUT_MS=30000
ACCOUNT_MIN_INTERVAL_MS=1200
RATE_LIMIT_BASE_COOLDOWN_MS=600000
RATE_LIMIT_MAX_COOLDOWN_MS=3600000
MAX_TOKEN_ERRORS=3
MODEL_CACHE_TTL_MS=1800000

# WAF cookies (lightweight path, NO Playwright by default)
# Import from a real browser after login on https://chat.qwen.ai
# Required names: ssxmod_itna, tfstk, acw_tc
# Option A: raw cookie header
# WAF_COOKIE=ssxmod_itna=...; tfstk=...; acw_tc=...; ...
# Option B: JSON file mounted at data/waf-cookies.json
# Option C: POST /admin/api/waf/import
WAF_AUTO_HARVEST=0
WAF_COOKIE_REFRESH_MS=0
# Only set this if you intentionally install playwright for auto harvest:
# WAF_AUTO_HARVEST=1
