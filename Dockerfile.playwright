# syntax=docker/dockerfile:1
# Playwright-enabled image (optional).
# Avoids mcr.microsoft.com/playwright:vX.Y.Z-jammy tag mismatches
# by installing Chromium via official Playwright bootstrap on Node base.
FROM node:22-bookworm

ENV NODE_ENV=production \
    PORT=3000 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    WAF_AUTO_HARVEST=1 \
    WAF_PROFILE_DIR=/app/data/chrome-profile-waf \
    WAF_COOKIE_CACHE=/app/data/waf-cookies.json \
    TZ=Asia/Shanghai

WORKDIR /app

# Install only what we need for Chromium runtime via Playwright's own helper.
# This does use apt under the hood, but through a maintained Playwright script
# instead of a brittle hard-coded package list / missing MCR tag.
COPY package.json package-lock.json ./
RUN npm ci --omit=dev \
 && npx playwright install --with-deps chromium \
 && npm cache clean --force

COPY src ./src
COPY frontend ./frontend
COPY .env.example ./.env.example

RUN mkdir -p /app/data /app/tmp /ms-playwright \
 && chown -R node:node /app /ms-playwright

USER node

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=8s --start-period=60s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "src/index.js"]
